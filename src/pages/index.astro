---
import '../styles/global.css'; 
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import StackAndCertifications from '../components/StackAndCertifications.astro';
import ContactForm from '../components/ContactForm.astro';

import logoImg from '../assets/logo.png';
import Projects from '../components/Projects.astro';
import BackToTop from '../components/BackToTop.astro';

---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href={logoImg.src} />
    <title>Impulsaforce | David Román - Senior Salesforce  Developer</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
</head>
    <Header />
	<main class="bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 transition-colors" id="main-content">
        <BackToTop />
        <HeroSection />
        <ClientMarquee />
        <StackAndCertifications />
        <Projects />
        <ContactForm />
    </main>
	<Footer />

<script>
// Cargar tema inmediatamente al inicio
(function() {
    const html = document.documentElement;
    const storedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const initialTheme = storedTheme || (prefersDark ? 'dark' : 'light');
    
    // Aplicar tema inicial
    html.classList.toggle('dark', initialTheme === 'dark');
    
    // Cuando el DOM esté listo, configurar el botón
    document.addEventListener('DOMContentLoaded', function() {
        const toggleButton = document.getElementById('theme-toggle');
        
        if (toggleButton) {
            toggleButton.addEventListener('click', function() {
                const isDark = html.classList.contains('dark');
                const newTheme = isDark ? 'light' : 'dark';
                
                // Cambiar clase
                html.classList.toggle('dark', !isDark);
                
                // Guardar preferencia
                localStorage.setItem('theme', newTheme);
                
                // Actualizar iconos (si existen en el DOM)
                const lightIcon = document.querySelector('.light-icon');
                const darkIcon = document.querySelector('.dark-icon');
                
                if (lightIcon && darkIcon) {
                    lightIcon.classList.toggle('hidden', newTheme === 'dark');
                    darkIcon.classList.toggle('hidden', newTheme === 'light');
                }
            });
            
            // Inicializar iconos
            const lightIcon = document.querySelector('.light-icon');
            const darkIcon = document.querySelector('.dark-icon');
            const isDark = html.classList.contains('dark');
            
            if (lightIcon && darkIcon) {
                lightIcon.classList.toggle('hidden', isDark);
                darkIcon.classList.toggle('hidden', !isDark);
            }
        }
    });
})();
</script>
</body>
</html>