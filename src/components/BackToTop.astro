---
// src/components/BackToTop.astro
---

<button
  id="back-to-top"
  class="fixed bottom-8 right-8 z-50 p-4 rounded-2xl bg-sf-blue text-white shadow-2xl shadow-sf-blue/30 translate-y-20 opacity-0 transition-all duration-500 hover:bg-sf-dark hover:-translate-y-1 active:scale-95 invisible cursor-pointer backdrop-blur-md border border-white/10"
  aria-label="Volver arriba"
>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    class="w-6 h-6" 
    fill="none" 
    viewBox="0 0 24 24" 
    stroke="currentColor"
  >
    <path 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      stroke-width="3" 
      d="M5 15l7-7 7 7" 
    />
  </svg>
</button>

<script>
  // Función principal
  const initBackToTop = () => {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    const handleScroll = () => {
      if (window.scrollY > 300) {
        btn.classList.remove('translate-y-20', 'opacity-0', 'invisible');
        btn.classList.add('translate-y-0', 'opacity-100', 'visible');
      } else {
        btn.classList.add('translate-y-20', 'opacity-0', 'invisible');
        btn.classList.remove('translate-y-0', 'opacity-100', 'visible');
      }
    };

    // Escuchar scroll y click
    window.addEventListener('scroll', handleScroll);
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  };

  // Se ejecuta al cargar la página normalmente
  initBackToTop();

  // Y también se ejecuta si usas ViewTransitions de Astro
  document.addEventListener('astro:after-swap', initBackToTop);
</script>