---
// src/components/ExperienceTimeline.astro
---
<div class="relative">
    <div class="sticky top-24">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white flex items-center gap-3 transition-colors">
             <span class="w-8 h-1 bg-sf-blue rounded-full"></span> Experiencia Laboral
        </h2>
        <div class="bg-gray-50 dark:bg-gray-800 p-8 rounded-3xl shadow-lg border border-gray-100 dark:border-gray-700 transition-colors">
            <div class="space-y-0">
                
                <div class="relative pl-8 pb-10 border-l-2 border-sf-blue/20 dark:border-sf-blue/30 last:border-0 hover:border-sf-blue dark:hover:border-sf-light transition-colors group">
                    <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-sf-blue dark:bg-sf-light ring-4 ring-white dark:ring-gray-800 shadow-sm group-hover:scale-125 transition-transform"></div>
                    
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white">Senior Manager & Architect</h3>
                    <p class="text-sf-blue dark:text-sf-light font-medium mb-2">Consultora Big 4 | 2020 - Presente</p>
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed">Liderando transformaciones digitales multi-cloud.</p>
                </div>
                
                <div class="relative pl-8 pb-10 border-l-2 border-sf-blue/20 dark:border-sf-blue/30 last:border-0 hover:border-sf-blue dark:hover:border-sf-light transition-colors group">
                    <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-sf-blue dark:bg-sf-light ring-4 ring-white dark:ring-gray-800 shadow-sm group-hover:scale-125 transition-transform"></div>
                    
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white">Salesforce Lead Developer</h3>
                    <p class="text-sf-blue dark:text-sf-light font-medium mb-2">Tech Startup | 2017 - 2020</p>
                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed">Implementación de CI/CD y desarrollo de LWC complejos.</p>
                </div>
            </div>
        </div>
    </div>
</div>