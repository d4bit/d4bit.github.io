---
// src/components/LanguageToggle.astro
---

<div class="flex items-center">
  <button 
    id="lang-toggle"
    class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-sf-blue/20 bg-white/50 dark:bg-gray-800/50 hover:border-sf-blue transition-all duration-300 group"
  >
    <span id="lang-flag" class="text-xl group-hover:scale-110 transition-transform">🇺🇸</span>
    <span id="lang-text" class="text-[10px] font-bold uppercase tracking-widest text-sf-dark dark:text-white">English</span>
  </button>
</div>

<script is:inline>
  function updateLangUI() {
    const btn = document.getElementById('lang-toggle');
    const flag = document.getElementById('lang-flag');
    const text = document.getElementById('lang-text');
    
    const isTranslated = window.location.href.includes('tl=es') || window.location.host.includes('translate.goog');

    if (isTranslated) {
      flag.textContent = '🇬🇧';
      text.textContent = 'Back to English';
      btn.onclick = () => {
        window.location.href = 'https://d4bit.github.io/';
      };
    } else {
      flag.textContent = '🇪🇸';
      text.textContent = 'Traducir a Español';
      btn.onclick = () => {
        const currentUrl = window.location.href;
        const googleTranslateUrl = `https://translate.google.com/translate?sl=en&tl=es&u=${encodeURIComponent(currentUrl)}`;
        window.location.href = googleTranslateUrl;
      };
    }
  }

updateLangUI();
</script>