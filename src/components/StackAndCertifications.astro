---
import ExperienceTimeline from './ExperienceTimeline.astro';

const themeClasses = {
    cloud: "bg-indigo-50/80 text-indigo-800 dark:text-indigo-300 dark:bg-indigo-900/40 border-indigo-100 dark:border-indigo-800",
    sfDev: "bg-sky-50/80 text-sky-800 dark:text-sky-300 dark:bg-sky-900/40 border-sky-100 dark:border-sky-800",
    logic: "bg-emerald-50/80 text-emerald-800 dark:text-emerald-300 dark:bg-emerald-900/40 border-emerald-100 dark:border-emerald-800",
    web: "bg-orange-50/80 text-orange-800 dark:text-orange-300 dark:bg-orange-900/40 border-orange-100 dark:border-orange-800"
};
const techStack = [
    { name: "Sales Cloud", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRJM0K9gRRQ5NkZAt4krbMQz1PumLjEb3N8dg&s", theme: "cloud" },
    { name: "Service Cloud", logo: "https://cdn.worldvectorlogo.com/logos/salesforce-service-cloud.svg", theme: "cloud" },
    { name: "Field Service", logo: "https://cdn.prod.website-files.com/62ab14c60bfc7da7685ed1fb/652d1e4c8404dd7d3f4b6a18_unnamed-removebg-preview.png", theme: "cloud" },
    { name: "Experience Cloud", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTqLrI3yh9TdQUIUCtFvjAP0dM1AIyQGug0yg&s", theme: "cloud" },
    { name: "Data Cloud", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ8AmVBtmz6ljV5jrgKTx5Gh-h5LduKiRXGug&s", theme: "cloud" },
    { name: "Agentforce", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSC_QFbTFMasUfnuKan4pWGlVr4700Fo7_9-w&s", theme: "cloud" },
    { name: "Apex", logo: "https://www.vectorlogo.zone/logos/salesforce/salesforce-icon.svg", theme: "sfDev" },
    { name: "LWC", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTIzBuTefuhQLcRcXbp6ihCN2kQ4GAeHRSEEQ&s", theme: "sfDev" },
    { name: "Flows", logo: "https://www.vectorlogo.zone/logos/salesforce/salesforce-icon.svg", theme: "sfDev" },
    { name: "SOQL", logo: "https://www.vectorlogo.zone/logos/salesforce/salesforce-icon.svg", theme: "sfDev" },
    { name: "Copado", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTm-tpuvrVWvqmVznvmAx0PisAKZWqZUvi6lA&s", theme: "sfDev" },
    { name: "Integraciones", logo: "https://www.vectorlogo.zone/logos/mulesoft/mulesoft-icon.svg", theme: "sfDev" },
    { name: "Javascript", logo: "https://www.vectorlogo.zone/logos/javascript/javascript-icon.svg", theme: "logic" },
    { name: "Node.js", logo: "https://www.vectorlogo.zone/logos/nodejs/nodejs-icon.svg", theme: "logic" },
    { name: "Python", logo: "https://www.vectorlogo.zone/logos/python/python-icon.svg", theme: "logic" },
    { name: "NPM", logo: "https://www.vectorlogo.zone/logos/npmjs/npmjs-icon.svg", theme: "logic" },
    { name: "Astro", logo: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR5KhCojo9MAD9u7-vbHjYYFzD69By9d-PWcw&s", theme: "web" },
    { name: "VueJS", logo: "https://www.vectorlogo.zone/logos/vuejs/vuejs-icon.svg", theme: "web" },
    { name: "Tailwind CSS", logo: "https://www.vectorlogo.zone/logos/tailwindcss/tailwindcss-icon.svg", theme: "web" },
    { name: "CSS", logo: "https://www.vectorlogo.zone/logos/w3_css/w3_css-icon.svg", theme: "web" }
];
const categories = [
    { id: "cloud", label: "Salesforce Core & Clouds" },
    { id: "sfDev", label: "Development & DevOps" },
    { id: "logic", label: "Backend & Logic" },
    { id: "web", label: "Frontend & Web" }
];

const groupedStack = categories.map(cat => ({
    ...cat,
    items: techStack.filter(tech => tech.theme === cat.id)
}));

const certifications = [
    { title: "Application Architect", url: "https://trailhead.salesforce.com/en/credentials/applicationarchitect", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Application-Architect.png" },
    { title: "Sharing and Visibility Architect", url: "https://trailhead.salesforce.com/en/credentials/sharingandvisibilityarchitect", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Sharing-and-Visibility-Designer.png" },
    { title: "Data Architect", url: "https://trailhead.salesforce.com/en/credentials/dataarchitect", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Data-Architecture-and-Management-Designer.png" },
    { title: "Platform Developer II", url: "https://trailhead.salesforce.com/en/credentials/platformdeveloperii", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Platform-Developer-II.png" },
    { title: "Agentforce Specialist", url: "https://trailhead.salesforce.com/en/credentials/agentforcespecialist", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/2025-02_Badge_SF-Certified_Agentforce-Specialist_High-Res.png" },
    { title: "Service Cloud Consultant", url: "https://trailhead.salesforce.com/en/credentials/servicecloudconsultant", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Service-Cloud-Consultant.png" },
    { title: "JavaScript Developer I", url: "https://trailhead.salesforce.com/en/credentials/javascriptdeveloperi", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/JavaScript-Developer-I.png" },
    { title: "Platform Developer I", url: "https://trailhead.salesforce.com/en/credentials/platformdeveloperi", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Platform-Developer-I.png" },
    { title: "Platform App Builder", url: "https://trailhead.salesforce.com/en/credentials/platformappbuilder", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Platform-App-Builder.png" },
    { title: "AI Associate", url: "https://trailhead.salesforce.com/en/credentials/aiassociate", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/ai-associate.png?v=2" },
    { title: "Salesforce Administrator", url: "https://trailhead.salesforce.com/en/credentials/administrator", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Administrator.png" },
    { title: "Salesforce Associate", url: "https://trailhead.salesforce.com/en/credentials/associate", logo: "https://developer.salesforce.com/resources2/certification-site/images/Certifications-logo/Associate.png" },
    { title: "Process Automation Accredited Professional", url: "https://trailhead.salesforce.com/en/credentials/processautomationaccreditedprofessional", logo: "https://developer.salesforce.com/resources2/certification-site/images/2021-04_PLC-AP-Badge_Process_Automation_High-Res.png" }
];
---

<section id="stack" class="w-full py-24 px-4 bg-white dark:bg-gray-700 relative overflow-hidden transition-colors duration-500">
    
    <div class="absolute inset-0 z-0 opacity-[0.1] dark:opacity-[0.1] pointer-events-none"
        style="mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); 
            -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="animated-grid">
            <defs>
                <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#00A1E0" stroke-width="1.5" class="grid-path" />
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid)" />
        </svg>
    </div>
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-20 relative z-10">
        
        <div>
            <h2 class="text-3xl font-bold mb-8 text-sf-dark dark:text-white flex items-center gap-3">
                <span class="w-8 h-1 bg-sf-blue rounded-full"></span> Tech Stack
            </h2>
            <div class="space-y-10 mb-20">
                {groupedStack.map((group) => (
                    <div class="group/category">
                        <h3 class="text-[10px] uppercase tracking-[0.2em] text-gray-400 dark:text-white font-bold mb-4 flex items-center gap-2">
                            {group.label}
                        </h3>
                        <div class="flex flex-wrap gap-3">
                            {group.items.map((tech) => (
                                <span class={`inline-flex items-center gap-2.5 px-4 py-2 rounded-xl font-medium text-xs transition-all shadow-sm border hover:border-sf-blue hover:-translate-y-1 cursor-default backdrop-blur-md ${themeClasses[tech.theme]}`}>
                                    <img src={tech.logo} alt={tech.name} class="w-4 h-4 object-contain flex-shrink-0" />
                                    {tech.name}
                                </span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
            
            <div class="flex justify-between items-center mb-8">
                <h2 class="text-3xl font-bold text-sf-dark dark:text-white flex items-center gap-3">
                    <span class="w-8 h-1 bg-sf-blue rounded-full"></span> Certificaciones (13)
                </h2>
                <button id="toggle-certs" class="group text-xs font-bold uppercase tracking-widest text-sf-blue dark:text-sf-light flex items-center gap-2 outline-none cursor-pointer">
                    <span id="btn-text">Ver todas</span>
                    <svg id="btn-icon" class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>

            <div class="mb-16">
                <div id="cert-scroll-container" class="bg-gray-50/50 dark:bg-gray-800 backdrop-blur-lg p-6 rounded-3xl h-[400px] overflow-hidden relative border border-gray-100 dark:border-gray-600 shadow-inner block">
                    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-gray-50 dark:from-gray-800 to-transparent z-10 pointer-events-none"></div>
                    
                    <div class="animate-vertical-scroll space-y-4 py-2">
                        {[...certifications, ...certifications].map((cert) => (
                            <a href={cert.url} target="_blank" rel="noopener noreferrer" 
                               class="block bg-white dark:bg-gray-700/50 p-4 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-600 hover:border-sf-blue hover:scale-[1.02] transition-all duration-300 relative z-20">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 flex-shrink-0 bg-gray-50 dark:bg-gray-700 rounded-lg p-1 flex items-center justify-center">
                                        <img src={cert.logo} alt="" class="max-w-full max-h-full object-contain" />
                                    </div>
                                    <p class="font-bold text-sf-dark dark:text-white text-sm leading-tight">{cert.title}</p>
                                </div>
                            </a>
                        ))}
                    </div>

                    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-gray-50 dark:from-gray-800 to-transparent z-10 pointer-events-none"></div>
                </div>

                <div id="cert-full-list" class="hidden space-y-4 animate-fade-in-up">
                    {certifications.map((cert) => (
                        <a href={cert.url} target="_blank" rel="noopener noreferrer" 
                           class="block bg-white dark:bg-gray-800 p-4 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-600 hover:border-sf-blue transition-all">
                            <div class="flex items-center gap-4">
                                <img src={cert.logo} alt="" class="w-12 h-12 object-contain" />
                                <p class="font-bold text-sf-dark dark:text-white text-sm">{cert.title}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </div>

        <div class="relative z-10">
            <ExperienceTimeline />
        </div>
    </div>
</section>

<script>
    const btn = document.getElementById('toggle-certs');
    const scrollContainer = document.getElementById('cert-scroll-container');
    const fullList = document.getElementById('cert-full-list');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');

    btn?.addEventListener('click', () => {
        const isScrolling = !scrollContainer?.classList.contains('hidden');
        if (isScrolling) {
            scrollContainer?.classList.replace('block', 'hidden');
            fullList?.classList.replace('hidden', 'block');
            btnText!.textContent = 'Cerrar';
            btnIcon?.classList.add('rotate-180');
        } else {
            scrollContainer?.classList.replace('hidden', 'block');
            fullList?.classList.replace('block', 'hidden');
            btnText!.textContent = 'Ver todas';
            btnIcon?.classList.remove('rotate-180');
        }
    });
</script>

<style>
    .animate-vertical-scroll {
        animation: scroll-vertical 30s linear infinite;
    }
    .animate-vertical-scroll:hover {
        animation-play-state: paused;
    }
    @keyframes scroll-vertical {
        0% { transform: translateY(0); }
        100% { transform: translateY(-50%); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out forwards;
    }
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    /* Animamos el patrón para que parezca que la cuadrícula se mueve */
    @keyframes grid-flow {
        0% { background-position: 0 0; }
        100% { background-position: 32px 32px; }
    }

    .animate-grid {
        animation: grid-flow 2s linear infinite;
    }
</style>