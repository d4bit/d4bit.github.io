---
// src/components/ContactForm.astro
---
<section id="contact" class="py-20 px-4 transition-colors duration-500 bg-gray-100 dark:bg-gray-700">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-extrabold text-center mb-12 text-sf-dark dark:text-white">
            ¿Hablamos?
        </h2>

        <div class="bg-white dark:bg-gray-800 p-8 md:p-12 rounded-3xl shadow-2xl dark:shadow-none transition-all duration-500 border border-gray-100 dark:border-gray-700">
            
            <form action="#" method="POST" class="space-y-6">
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <input type="text" id="name" name="name" placeholder="Nombre Completo" required 
                           class="w-full p-3 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-sf-blue focus:border-sf-blue bg-gray-50 dark:bg-gray-900 text-sf-dark dark:text-white transition-all duration-300 shadow-sm outline-none"
                    >
                    <input type="email" id="email" name="email" placeholder="Tu Email" required 
                           class="w-full p-3 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-sf-blue focus:border-sf-blue bg-gray-50 dark:bg-gray-900 text-sf-dark dark:text-white transition-all duration-300 shadow-sm outline-none"
                    >
                    <input type="tel" id="phone" name="phone" placeholder="Tu Teléfono (Opcional)" 
                           class="w-full p-3 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-sf-blue focus:border-sf-blue bg-gray-50 dark:bg-gray-900 text-sf-dark dark:text-white transition-all duration-300 shadow-sm outline-none"
                    >
                </div>

                <div>
                    <input type="text" id="subject" name="subject" placeholder="Asunto" required 
                           class="w-full p-3 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-sf-blue focus:border-sf-blue bg-gray-50 dark:bg-gray-900 text-sf-dark dark:text-white transition-all duration-300 shadow-sm outline-none"
                    >
                </div>
                
                <div>
                    <textarea id="message" name="message" rows="5" placeholder="Mensaje..." required 
                              class="w-full p-3 border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-sf-blue focus:border-sf-blue bg-gray-50 dark:bg-gray-900 text-sf-dark dark:text-white transition-all duration-300 resize-y shadow-sm outline-none"
                    ></textarea>
                </div>

                <div class="flex justify-center pt-4">
                    <button type="submit" 
                            class="w-full md:w-auto px-12 py-3 text-lg font-bold text-white rounded-full 
                                   bg-sf-blue hover:bg-sf-dark
                                   transition-all transform hover:-translate-y-0.5 hover:shadow-xl hover:shadow-sf-blue/30"
                    >
                        Enviar Mensaje
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>