---
// src/components/ContactForm.astro
import logoImg from '../assets/logo.png';
---

<section id="contact" class="py-24 px-4 bg-gray-100 dark:bg-gray-700 transition-colors duration-500 relative overflow-hidden">
    
    <div class="absolute inset-0 pointer-events-none opacity-[0.25] dark:opacity-[0.8] mix-blend-multiply dark:mix-blend-soft-light animate-grid-flow" 
         style="background-image: radial-gradient(var(--sf-blue) 1.8px, transparent 1.8px); background-size: 32px 32px;">
    </div>

    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center relative z-10">
        
        <div class="space-y-10">
            <div class="space-y-6">
<h2 class="text-4xl md:text-5xl font-black text-sf-dark dark:text-white leading-[1.1] tracking-tight">
            Tu desafío técnico <br class="hidden md:block" /> tiene solución
        </h2>
        
        <h3 class="text-2xl md:text-3xl font-semibold text-sf-blue tracking-tight">
            Busquémosla juntos
        </h3>
    </div>
    
    <div class="relative">
        <div class="absolute -left-4 top-0 bottom-0 w-1 bg-sf-blue/20 rounded-full"></div>
        <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-lg leading-relaxed pl-2">
            Especializado en <span class="text-sf-blue dark:text-white font-medium">Salesforce</span> y apasionado por las buenas prácticas. Si tienes un reto técnico o solo quieres intercambiar ideas, mi bandeja de entrada está abierta.
        </p>
    </div>

            <div class="grid sm:grid-cols-2 gap-6">
                <div class="p-6 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl dark:border-sf-blue shadow-sm group hover:border-sf-blue transition-all border border-transparent">
                    <div class="w-10 h-10 bg-blue-50 dark:bg-sf-blue/10 rounded-lg flex items-center justify-center text-sf-blue mb-4">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    </div>
                    <p class="text-sm font-bold text-gray-400 uppercase">Red Profesional</p>
                    <a href="https://www.linkedin.com/in/dabitforce/" target="_blank" class="text-sf-dark dark:text-white font-medium dark:hover:text-sf-blue hover:text-sf-blue transition-colors">linkedin.com/in/dabitforce</a>
                </div>

                <div class="p-6 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl dark:border-sf-blue shadow-sm group hover:border-sf-blue transition-all border border-transparent">
                    <div class="w-10 h-10 bg-blue-50 dark:bg-sf-blue/10 rounded-lg flex items-center justify-center text-sf-blue mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <p class="text-sm font-bold text-gray-400 uppercase">Disponibilidad</p>
                    <p class="text-sf-dark dark:text-white font-medium">Lunes a Viernes</p>
                </div>
            </div>
        </div>

        <div class="relative">
            <div class="absolute -top-4 right-8 z-20 bg-sf-blue text-white text-[10px] font-bold px-4 py-1.5 rounded-full shadow-lg uppercase tracking-widest border-2 border-white dark:border-gray-800">
                Cuéntame tu idea
            </div>

            <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-md p-8 md:p-10 rounded-[2.5rem] shadow-2xl shadow-sf-blue/10 border border-gray-100 dark:border-gray-700 relative overflow-hidden">
                
                <form action="#" method="POST" class="space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Nombre</label>
                            <input type="text" name="name" placeholder="Tu nombre" required 
                                   class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 transition-all placeholder-gray-400 dark:placeholder-gray-500">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Email Profesional</label>
                            <input type="email" name="email" placeholder="ejemplo@empresa.com" required 
                                   class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 transition-all placeholder-gray-400 dark:placeholder-gray-500">
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Servicio de interés</label>
                        <div class="relative">
                            <select 
                            required
                            class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 appearance-none transition-all cursor-pointer group-hover:border-sf-blue/30"
                        >                                
                            <option value="" class="text-gray-200" disabled selected hidden>Selecciona un motivo...</option>
                            
                            <option value="colaboracion" class="py-2">Colaboración en proyectos / Partners</option>
                            <option value="opinion" class="py-2">Segunda opinión técnica / Code Review</option>
                            <option value="arquitectura" class="py-2">Desafíos de Arquitectura o Integración</option>
                            <option value="cafe" class="py-2">Charlar sobre el ecosistema (Café virtual)</option>
                            <option value="otro" class="py-2">Otros asuntos</option>
                        </select>
                            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Mensaje</label>
                        <textarea name="message" rows="4" placeholder="Breve descripción de sus necesidades..." required 
                                  class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 resize-none transition-all placeholder-gray-400 dark:placeholder-gray-500"></textarea>
                    </div>

                    <button type="submit" 
                            class="group w-full py-4 bg-sf-blue hover:bg-sf-dark text-white font-bold rounded-2xl shadow-xl shadow-sf-blue/20 transition-all flex items-center justify-center gap-3 active:scale-[0.98] cursor-pointer">
                        <span>Iniciar Conversación</span>
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
<div class="w-full overflow-hidden leading-[0] bg-gray-100 dark:bg-gray-700 -mb-1 relative z-10">
    <svg class="relative block w-[calc(100%+1.3px)] h-[50px] rotate-180 overflow-visible" viewBox="0 0 1200 120" preserveAspectRatio="none">
        
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" 
              class="fill-gray-900 dark:fill-gray-900"></path>

        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3" 
              fill="none" 
              stroke="var(--sf-blue)" 
              stroke-width="6" 
              stroke-linecap="round"></path>
              
        <path d="M0,27.35A600.21,600.21,0,0,0,321.39,56.44" 
              fill="none" 
              stroke="var(--sf-blue)" 
              stroke-width="6" 
              stroke-linecap="round"></path>

    </svg>
</div>
<style>
    @keyframes grid-flow {
        0% { background-position: 0 0; }
        100% { background-position: 32px 32px; }
    }

    .animate-grid-flow {
        animation: grid-flow 2s linear infinite;
    }
</style>