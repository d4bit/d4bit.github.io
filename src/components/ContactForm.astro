---
// src/components/ContactForm.astro
import logoImg from '../assets/logo.png';
---

<section id="contact" class="py-24 px-4 bg-gray-100 dark:bg-gray-700 transition-colors duration-500 relative overflow-hidden">
    
    <div class="absolute inset-0 pointer-events-none opacity-[0.25] dark:opacity-[0.8] mix-blend-multiply dark:mix-blend-soft-light animate-grid-flow" 
         style="background-image: radial-gradient(var(--sf-blue) 1.8px, transparent 1.8px); background-size: 32px 32px;">
    </div>

    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center relative z-10">
        
        <div class="space-y-10">
            <div class="space-y-6">
                <h2 class="text-5xl md:text-6xl font-black text-sf-dark dark:text-white leading-[1.1]">
                    ¿Tienes un desafío técnico? <br/>
                    <span class="text-sf-blue">Construyamos la solución.</span>
                </h2>
                
                <p class="text-xl text-gray-600 dark:text-gray-400 max-w-lg leading-relaxed">
                    Especializado en auditorías de código, arquitectura de integraciones y despliegues críticos en el ecosistema <span class="text-sf-blue font-semibold">Salesforce</span>.
                </p>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
                <div class="p-6 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl dark:border-sf-blue shadow-sm group hover:border-sf-blue transition-all border border-transparent">
                    <div class="w-10 h-10 bg-blue-50 dark:bg-sf-blue/10 rounded-lg flex items-center justify-center text-sf-blue mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <p class="text-sm font-bold text-gray-400 uppercase">Email Directo</p>
                    <p class="text-sf-dark dark:text-white font-medium break-all">hola@tu-dominio.com</p>
                </div>

                <div class="p-6 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-2xl dark:border-sf-blue shadow-sm group hover:border-sf-blue transition-all border border-transparent">
                    <div class="w-10 h-10 bg-blue-50 dark:bg-sf-blue/10 rounded-lg flex items-center justify-center text-sf-blue mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <p class="text-sm font-bold text-gray-400 uppercase">Tiempo de respuesta</p>
                    <p class="text-sf-dark dark:text-white font-medium">&lt; 24 horas laborables</p>
                </div>
            </div>
        </div>

        <div class="relative">
            <div class="absolute -top-4 right-8 z-20 bg-sf-blue text-white text-[10px] font-bold px-4 py-1.5 rounded-full shadow-lg uppercase tracking-widest border-2 border-white dark:border-gray-800">
                New Case Request
            </div>

            <div class="bg-white/90 dark:bg-gray-800/90 backdrop-blur-md p-8 md:p-10 rounded-[2.5rem] shadow-2xl shadow-sf-blue/10 border border-gray-100 dark:border-gray-700 relative overflow-hidden">
                
                <form action="#" method="POST" class="space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Nombre</label>
                            <input type="text" name="name" placeholder="Ej: Marc Benioff" required 
                                   class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 transition-all placeholder-gray-400 dark:placeholder-gray-500">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Email</label>
                            <input type="email" name="email" placeholder="marc@salesforce.com" required 
                                   class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 transition-all placeholder-gray-400 dark:placeholder-gray-500">
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Área de Interés</label>
                        <div class="relative">
                            <select class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 appearance-none transition-all cursor-pointer">
                                <option>Arquitectura Salesforce</option>
                                <option>Desarrollo LWC / Apex</option>
                                <option>Integraciones (MuleSoft/API)</option>
                                <option>DevOps & CI/CD</option>
                                <option>Otro</option>
                            </select>
                            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold text-gray-400 ml-1 uppercase">Tu Mensaje</label>
                        <textarea name="message" rows="4" placeholder="Cuéntame sobre tu proyecto..." required 
                                  class="w-full p-4 bg-gray-50 dark:bg-gray-700/60 border border-gray-100 dark:border-gray-600 rounded-2xl text-sf-dark dark:text-white outline-none focus:ring-2 focus:ring-sf-blue/20 resize-none transition-all placeholder-gray-400 dark:placeholder-gray-500"></textarea>
                    </div>

                    <button type="submit" 
                            class="group w-full py-4 bg-sf-blue hover:bg-sf-dark text-white font-bold rounded-2xl shadow-xl shadow-sf-blue/20 transition-all flex items-center justify-center gap-3 active:scale-[0.98] cursor-pointer">
                        <span>Enviar Solicitud</span>
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes grid-flow {
        0% { background-position: 0 0; }
        100% { background-position: 32px 32px; }
    }

    .animate-grid-flow {
        animation: grid-flow 2s linear infinite;
    }
</style>