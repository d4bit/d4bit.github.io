---
import SocialIcons from '../components/SocialIcons.astro';
import logoImg from '../assets/logo.png';
---

<div id="app-footer">
    <footer class="bg-gray-900 text-white py-12 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 items-start">
                
                <div class="flex flex-col items-center md:items-start space-y-3">
                    <div class="flex items-center gap-2 cursor-pointer group">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white font-bold text-xl shadow-lg transition-transform group-hover:scale-110">
                            <img src={logoImg.src} alt="ImpulsaForce Logo" class="object-contain" />
                        </div>
                        <span class="font-bold text-xl tracking-tight">Impulsa<span class="text-sf-blue">Force</span></span>
                    </div>
                    <p class="text-sm text-gray-400 text-center md:text-left pt-2">
                        Transformando empresas mediante la arquitectura <span class="text-gray-200">Salesforce</span>.
                    </p>
                </div>
                
                <div class="text-center md:text-left">
                    <h3 class="text-lg font-semibold mb-4 text-sf-blue">Explorar</h3>
                    <ul class="space-y-2">
                        <li><a href="/" class="text-gray-300 hover:text-sf-blue transition-colors duration-300">Inicio</a></li>
                        <li><a href="/blog" class="text-gray-300 hover:text-sf-blue transition-colors duration-300">Blog</a></li>
                    </ul>
                </div>
                
                <div class="flex flex-col items-center md:items-end">
                    <SocialIcons />
                </div>

            </div>
            
            <div class="mt-10 pt-6 border-t border-gray-800 text-center flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-sm text-gray-500">
                    &copy; {new Date().getFullYear()} ImpulsaForce. Desarrollado con el ecosistema Salesforce en mente.
                </p>
                
                <p class="text-sm text-gray-500 flex items-center gap-1">
                    Hecho con 🩵 por 
                    <a 
                        href="https://github.com/d4bit" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="text-gray-300 hover:text-sf-blue font-medium transition-colors duration-300 underline underline-offset-4 decoration-sf-blue/30"
                    >
                        David Román
                    </a>
                </p>
            </div>
            
        </div>
    </footer>
</div>