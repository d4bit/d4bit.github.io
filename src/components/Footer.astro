---
import SocialIcons from '../components/SocialIcons.astro';
---

<div id="app-footer">
        <footer class="bg-gray-800 text-white py-12 border-t border-gray-700">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 items-start">
                    
                    <div class="flex flex-col items-center md:items-start space-y-3">
                        <div class="flex items-center gap-3 cursor-pointer">
                            <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-lg flex items-center justify-center text-white font-bold text-xl shadow-lg">A</div>
                            <span class="font-bold text-xl tracking-tight">Alex<span class="text-blue-400">Architect</span></span>
                        </div>
                        <p class="text-sm text-gray-400 text-center md:text-left pt-2">
                            Construyendo soluciones sólidas y escalables.
                        </p>
                    </div>
                    
                    <div class="text-center md:text-left">
                        <h3 class="text-lg font-semibold mb-4 text-blue-400">Explorar</h3>
                        <ul class="space-y-2">
                            <li><a href="#inicio" class="text-gray-300 hover:text-blue-400 transition-colors duration-300">Inicio</a></li>
                            <li><a href="#contact" class="text-gray-300 hover:text-blue-400 transition-colors duration-300">Contactar</a></li>
                            <li><a href="mailto:tu.email@ejemplo.com" class="text-gray-300 hover:text-blue-400 transition-colors duration-300">Escríbeme un Email</a></li>
                        </ul>
                    </div>
                    
                    <div class="flex flex-col items-center md:items-end">
                        <h3 class="text-lg font-semibold mb-4 text-blue-400">Conectar</h3>
                        <SocialIcons />
                    </div>

                </div>
                
                <div class="mt-10 pt-6 border-t border-gray-700 text-center">
                    <p class="text-sm text-gray-500">&copy; 2025 DabitForce. Todos los derechos reservados.</p>
                </div>
                
            </div>
        </footer>
    </div>