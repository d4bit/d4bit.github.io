---
import SocialIcons from '../components/SocialIcons.astro';
import logoImg from '../assets/logo.png';
---
<div class="w-full overflow-hidden leading-[0] bg-gray-100 dark:bg-gray-700 -mb-1 relative z-10">
    <svg class="relative block w-[calc(100%+1.3px)] h-[50px] rotate-180 overflow-visible" viewBox="0 0 1200 120" preserveAspectRatio="none">
        
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" 
              class="fill-gray-900 dark:fill-gray-900"></path>

        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3" 
              fill="none" 
              stroke="var(--sf-blue)" 
              stroke-width="6" 
              stroke-linecap="round"></path>
              
        <path d="M0,27.35A600.21,600.21,0,0,0,321.39,56.44" 
              fill="none" 
              stroke="var(--sf-blue)" 
              stroke-width="6" 
              stroke-linecap="round"></path>

    </svg>
</div>

<div id="app-footer">
        <footer class="bg-gray-900 text-white py-12 border-gray-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 items-start">
                    
                    <div class="flex flex-col items-center md:items-start space-y-3">
                        <div class="flex items-center gap-2 cursor-pointer group">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white font-bold text-xl shadow-lg transition-transform group-hover:scale-110">
                                <img src={logoImg.src} alt="ImpulsaForce Logo" class="object-contain" />
                            </div>
                            <span class="font-bold text-xl tracking-tight">Impulsa<span class="text-sf-blue">Force</span></span>
                        </div>
                        <p class="text-sm text-gray-400 text-center md:text-left pt-2">
                            Transformando empresas mediante la arquitectura <span class="text-gray-200">Salesforce</span>.
                        </p>
                    </div>
                    
                    <div class="text-center md:text-left">
                        <h3 class="text-lg font-semibold mb-4 text-sf-blue">Explorar</h3>
                        <ul class="space-y-2">
                            <li><a href="#inicio" class="text-gray-300 hover:text-sf-blue transition-colors duration-300">Inicio</a></li>
                            <li><a href="#contact" class="text-gray-300 hover:text-sf-blue transition-colors duration-300">Contactar</a></li>
                        </ul>
                    </div>
                    
                    <div class="flex flex-col items-center md:items-end">
                        <h3 class="text-lg font-semibold mb-4 text-sf-blue">Conectar</h3>
                        <SocialIcons />
                    </div>

                </div>
                
                <div class="mt-10 pt-6 border-t border-gray-800 text-center">
                    <p class="text-sm text-gray-500">&copy; {new Date().getFullYear()} ImpulsaForce. Desarrollado con el ecosistema Salesforce en mente.</p>
                </div>
                
            </div>
        </footer>
    </div>