---
// src/components/HeroSection.astro
import { Image } from 'astro:assets';
import avionetaImg from '../assets/airplane.png';
---
<section id="inicio" class="pt-20 lg:pt-0 min-h-screen flex items-center pb-12 relative overflow-hidden transition-colors duration-500 bg-white dark:bg-[#0a0a0a]">
    
    <div class="absolute inset-0 z-0 pointer-events-none">
        <img 
            src="https://abhimanyud3dx.github.io/superqbit-static-resources/resources/images/bg/bg1.png" 
            alt="Background Grid" 
            class="w-full h-full object-cover dark:opacity-45 opacity-20"
        />
    </div>

    <div class="hidden lg:block absolute inset-0 z-[2] pointer-events-none">
        <div class="avioneta-container absolute top-1/3 left-[-100px]">
            <div class="flex flex-col items-center">
                <div class="w-16 h-16 -rotate-12 opacity-50">
                    <img src={avionetaImg.src} alt="avioneta" class="w-full h-full object-contain" />
                </div>
                <div class="w-24 h-[1px] bg-gradient-to-l from-sf-blue/20 to-transparent mt-1 mr-12"></div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 w-full grid lg:grid-cols-2 gap-16 items-center">
        
        <div class="space-y-8 animate-fade-in-up z-10 order-2 lg:order-1 flex flex-col items-center lg:items-start text-center lg:text-left">            
            <h1 class="text-5xl lg:text-7xl font-bold text-sf-dark dark:text-white leading-[1.1] transition-colors">
                Architecting Scalable <br/>
                <span class="text-sf-blue bg-clip-text bg-gradient-to-r from-sf-blue to-sf-light">
                    Cloud Solutions
                </span>
            </h1>
            
            <p class="text-lg text-gray-600 dark:text-sf-dark/10 max-w-lg leading-relaxed border-l-0 lg:border-l-4 border-sf-dark dark:border-sf-dark dark:text-white pl-0 lg:pl-4 transition-colors">
                Transformando negocios a través de la arquitectura Salesforce de alto rendimiento.
            </p>

            <div class="flex flex-wrap gap-4 pt-2 justify-center lg:justify-start">
                <a href="#contact" class="px-8 py-3.5 bg-sf-blue text-white rounded-xl font-semibold hover:opacity-90 hover:shadow-lg hover:shadow-sf-blue/30 transition-all transform hover:-translate-y-1">
                    Contactar
                </a>
                <a href="#stack" class="px-8 py-3.5 bg-white dark:bg-gray-800 text-sf-light dark:text-white border border-gray-200 dark:border-gray-600 rounded-xl font-semibold hover:bg-gray-50 dark:hover:bg-gray-600 hover:border-sf-blue transition-all">
                    Ver Stack
                </a>
            </div>
        </div>

        <div class="relative order-1 lg:order-2 flex justify-center lg:justify-end animate-fade-in-delayed z-10 ">
            <div class="relative w-[320px] md:w-[450px] aspect-[4/5] min-w-64"> 
                
                <img src="https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&q=80&w=800" 
                    alt="Profile" 
                    class="w-full h-full object-cover rounded-[2rem] shadow-2xl z-10 relative transition-opacity duration-700">
                
                <div class="absolute -top-6 -left-8 z-20 bg-white/90 dark:bg-gray-800 backdrop-blur-md p-4 rounded-2xl shadow-xl border border-white/50 dark:border-gray-700 animate-float-slow max-w-[160px]">
                    <div class="flex items-center gap-3">
                        <div class="p-2 bg-blue-50 dark:bg-sf-blue/20 rounded-lg text-sf-blue dark:text-sf-light">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <div>
                            <p class="text-2xl font-bold leading-none text-sf-dark dark:text-sf-light">+4</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 font-medium uppercase mt-1">Años Exp.</p>
                        </div>
                    </div>
                </div>

                <div class="absolute -bottom-8 -right-4 z-30 bg-gray-800 text-white p-5 rounded-2xl shadow-2xl animate-float-medium max-w-[180px]">
                    <p class="text-3xl font-bold text-sf-blue mb-1">13</p>
                    <p class="text-sm text-blue-100 leading-tight">Certificaciones Oficiales Salesforce</p>
                </div>

                <div class="absolute top-12 -right-6 md:-right-10 z-20 bg-white dark:bg-gray-800 p-3 md:p-4 rounded-xl shadow-xl animate-float-medium border border-gray-100 dark:border-gray-700 transform rotate-3">
                    <div class="text-center">
                        <p class="text-xl md:text-2xl font-bold text-sf-blue dark:text-sf-light">+30</p>
                        <p class="text-[8px] md:text-[10px] text-gray-400 dark:text-gray-300 uppercase font-bold tracking-wider">Proyectos</p>
                    </div>
                </div>

                <div class="absolute bottom-12 -left-12 z-30 bg-white/90 dark:bg-gray-800/90 backdrop-blur-md p-3 rounded-2xl shadow-xl border border-white/50 dark:border-gray-700 animate-float-slow flex items-center gap-3">
                    <img 
                        src="https://res.cloudinary.com/trailhead/image/upload/public-trailhead/assets/images/ranks/all-star-ranger.png" 
                        alt="All-Star Ranger" 
                        class="w-12 h-12 md:w-14 md:h-14 object-contain"
                    />
                    <div class="pr-2">
                        <p class="text-sm font-bold text-sf-dark dark:text-white leading-none">All-Star</p>
                        <p class="text-[10px] text-sf-blue font-extrabold uppercase tracking-tighter mt-1">Ranger Rank</p>
                    </div>
                </div>

                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-sf-blue/10 rounded-full blur-2xl -z-10"></div>
                <div class="absolute top-10 -right-10 w-40 h-40 bg-sf-light/10 rounded-full blur-2xl -z-10"></div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Animación de la Avioneta */
    .avioneta-container {
        animation: fly-across 30s linear infinite;
    }

    @keyframes fly-across {
        0% { transform: translate(-10vw, 0) rotate(5deg); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translate(110vw, -150px) rotate(-5deg); opacity: 0; }
    }

    /* Animaciones de los badges flotantes */
    @keyframes float-slow { 
        0%, 100% { transform: translateY(0); } 
        50% { transform: translateY(-15px); } 
    }
    @keyframes float-medium { 
        0%, 100% { transform: translateY(0); } 
        50% { transform: translateY(-20px); } 
    }
    
    .animate-float-slow { animation: float-slow 5s ease-in-out infinite; }
    .animate-float-medium { animation: float-medium 4s ease-in-out infinite; }

    .animate-fade-in-up { animation: fadeInUp 0.8s ease-out forwards; }
    .animate-fade-in-delayed { animation: fadeIn 1.2s ease-out forwards; opacity: 0; }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>